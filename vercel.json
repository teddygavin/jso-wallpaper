{
  "version": 2,
  "buildCommand": "node lib/seed.js",
  "routes": [
    { "src": "/api/products(.*)",   "dest": "/api/products.js"   },
    { "src": "/api/categories(.*)", "dest": "/api/categories.js" },
    { "src": "/api/enquiries(.*)",  "dest": "/api/enquiries.js"  },
    { "src": "/api/upload",         "dest": "/api/upload.js"     },
    { "src": "/sitemap.xml",        "dest": "/api/sitemap.js"    },
    { "src": "/robots.txt",         "dest": "/api/robots.js"     },
    { "src": "/(.*)",               "dest": "/public/$1"         }
  ]
}