# ─────────────────────────────────────────────────────────────
# J.S.O Wallpaper & Interiors — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local to GitHub.
# Set these same variables in: Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── VERCEL POSTGRES (Neon) ────────────────────────────────────
# Created automatically when you add a Postgres store in Vercel Dashboard
# Storage → Create Database → Postgres → copy POSTGRES_URL
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# ── CLOUDINARY (image hosting) ───────────────────────────────
# Get these from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── EMAIL NOTIFICATIONS ───────────────────────────────────────
# Gmail address that SENDS the enquiry notification emails
EMAIL_USER=hello@jsowallpaper.co.ke
# Gmail App Password (NOT your normal Gmail password)
# Create at: Google Account → Security → 2-Step Verification → App passwords
EMAIL_PASS=your_gmail_app_password
# Address that RECEIVES the notification (can be the same as EMAIL_USER)
EMAIL_TO=hello@jsowallpaper.co.ke

# ── ADMIN PANEL ───────────────────────────────────────────────
# Password to access /admin and all protected API routes
ADMIN_PASSWORD=choose_a_strong_password_here
